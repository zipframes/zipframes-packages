{
  "name": "@zipframes/schemas",
  "version": "0.1.0",
  "description": "Contratos de eventos e de API, organizados por serviço publicador.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./auth-service": {
      "types": "./dist/services/auth-service/index.d.ts",
      "default": "./dist/services/auth-service/index.js"
    },
    "./video-service": {
      "types": "./dist/services/video-service/index.d.ts",
      "default": "./dist/services/video-service/index.js"
    },
    "./processor-worker": {
      "types": "./dist/services/processor-worker/index.d.ts",
      "default": "./dist/services/processor-worker/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zipframes/core": "workspace:^",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
